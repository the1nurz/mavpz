erDiagram
    PUBLISHER ||--o{ BOOK : publishes
    AUTHOR }|--o{ BOOK : writes
    BOOK ||--o{ COPY : has
    READER ||--o{ LOAN : borrows
    COPY ||--o{ LOAN : "is lent in"
    READER ||--o{ RESERVATION : makes
    BOOK ||--o{ RESERVATION : "is reserved in"

    PUBLISHER {
        uuid id PK
        string name
        string country
    }
    AUTHOR {
        uuid id PK
        string full_name
        int birth_year
    }
    BOOK {
        uuid id PK
        string title
        string isbn UK
        int publication_year
        uuid publisher_id FK
    }
    COPY {
        uuid id PK
        uuid book_id FK
        string inventory_number UK
        string status
    }
    READER {
        uuid id PK
        string full_name
        string email UK
        datetime registered_at
    }
    LOAN {
        uuid id PK
        uuid reader_id FK
        uuid copy_id FK
        datetime loaned_at
        datetime due_at
        datetime returned_at
    }
    RESERVATION {
        uuid id PK
        uuid reader_id FK
        uuid book_id FK
        datetime reserved_at
        string status
    }
