erDiagram
    Publisher ||--o{ Book : publishes
    Author }|--o{ Book : writes
    Book ||--|{ Copy : includes
    Reader ||--o{ Loan : receives
    Copy ||--o{ Loan : records
    Reader ||--o{ Reservation : places
    Book ||--o{ Reservation : concerns

    Publisher {
        int id PK
        string name
    }
    Author {
        int id PK
        string full_name
    }
    Book {
        int id PK
        string title
        string isbn UK
        int publication_year
        int publisher_id FK
    }
    Copy {
        int id PK
        int book_id FK
        string inventory_number UK
        string physical_condition
    }
    Reader {
        int id PK
        string full_name
        string email
    }
    Loan {
        int id PK
        int reader_id FK
        int copy_id FK
        datetime issued_at
        datetime due_at
        datetime returned_at
    }
    Reservation {
        int id PK
        int reader_id FK
        int book_id FK
        datetime created_at
        string status
    }

    %% Loan.returned_at is NULL while the loan is open.
    %% At most one open Loan per Copy; historical loans remain stored.
    %% Reservations concern Book and do not require all copies to be on loan.
    %% Pending reservations for a Book are served by ascending created_at.
    %% Equal created_at values are ordered by ascending Reservation.id.
